SQLITE_PATH="./data/resopatch.sqlite3"
# The login passphrase itself is no longer set here — it's stored (hashed) in the database,
# defaults to "admin" on first run, and can be changed from the dashboard's settings panel.
JWT_SECRET="change-me-too"
PORT=3001
WEB_ORIGIN="http://localhost:5173"
BOT_API_KEY="change-me-bot-key"
# Disk space on this machine is extremely tight; point Puppeteer at the system Chrome
# instead of letting it download its own ~300MB Chromium copy.
PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
