{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "incremental": true,
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
